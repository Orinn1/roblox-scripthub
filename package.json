{
  "name": "roblox-scripthub",
  "version": "1.0.0",
  "description": "Roblox Script Hub with WEAO API & SQLite Database",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "web": "node server.js",
    "bot": "node bot/index.js",
    "bot:deploy": "node bot/deploy-commands.js",
    "super-bot": "node super-bot/index.js",
    "super-bot:deploy": "node super-bot/deploy-commands.js",
    "shop-bot": "node shop-bot/index.js",
    "shop-bot:deploy": "node shop-bot/deploy-commands.js",
    "build": "node build.js",
    "simple": "node simple-hub/server.js",
    "zip:discloud": "powershell -NoProfile -Command \"Compress-Archive -Path 'index.js', 'discloud.config', 'package.json', 'package-lock.json', 'db.js', '.env', 'bot', 'data' -DestinationPath 'discloud-bot.zip' -Force\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^17.4.2",
    "jimp": "^0.22.12",
    "jsqr": "^1.4.0",
    "tweetnacl": "^1.0.3"
  }
}
