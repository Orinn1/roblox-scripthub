# ==========================================
# 🤖 Discord Bot Settings (การตั้งค่าบอทดิสคอร์ด)
# ==========================================
# นำ Bot Token มาจาก https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# ID ของเซิร์ฟเวอร์ดิสคอร์ด (คลิกขวาที่ชื่อเซิร์ฟเวอร์ -> คัดลอก ID เซิร์ฟเวอร์)
GUILD_ID=your_guild_id_here

# ID ของยศแอดมิน/คนขาย (ที่ต้องการให้มองเห็นห้องตั๋ว และมีสิทธิ์กดอนุมัติสลิป)
STAFF_ROLE_ID=your_staff_role_id_here

# (ไม่บังคับ) ID ของยศสมาชิกเริ่มต้น (มอบให้อัตโนมัติเมื่อมีคนเข้าดิสคอร์ด)
AUTO_ROLE_ID=

# (ไม่บังคับ) ID ของยศลูกค้าที่จะมอบให้อัตโนมัติเมื่ออนุมัติสลิปสำเร็จ
CUSTOMER_ROLE_ID=

# (ไม่บังคับ) ID ห้องรีวิวลูกค้า (เช่น 🌟 • รีวิวจากลูกค้า)
REVIEW_CHANNEL_ID=

# (ไม่บังคับ) ID หมวดหมู่ (Category) ที่ต้องการให้สร้างห้องตั๋วไว้ด้านล่าง
TICKET_CATEGORY_ID=

# (ไม่บังคับ) ID ห้องสำหรับส่งประวัติตั๋ว (Transcript Log) เมื่อปิดตั๋ว
TRANSCRIPT_LOG_CHANNEL_ID=

# ==========================================
# 💳 ข้อมูลการชำระเงินของร้านค้า
# ==========================================
PROMPTPAY_NUMBER=0xx-xxx-xxxx
PROMPTPAY_NAME=ชื่อบัญชี / พร้อมเพย์
BANK_NAME=ธนาคารกสิกรไทย (KBANK)
BANK_ACCOUNT=xxx-x-xxxxx-x
