# ==========================================
# 🤖 Discord AI Q&A Bot Configuration
# ==========================================

# 1. Discord Bot Token (รับจาก Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# 2. Client ID / Application ID (รับจาก Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=your_discord_client_id_here

# 3. (ไม่บังคับ) Guild ID เซิร์ฟเวอร์สำหรับลงทะเบียน Slash Command ทันที (ไม่ต้องรอคิวทั่วโลก 1 ชม.)
DISCORD_GUILD_ID=1548669247998140438

# ==========================================
# 🧠 Google Gemini AI Configuration
# ==========================================

# 4. Gemini API Key (รับฟรีได้ทันทีที่ https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. โมเดล Gemini ที่ต้องการใช้งาน (แนะนำ: gemini-2.5-flash หรือ gemini-1.5-flash หรือ gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# ⚙️ Bot Behavior & Channel Settings
# ==========================================

# 6. (ไม่บังคับ) ไอดีห้องที่ต้องการให้บอทตอบคำถาม/คุยเล่นทันที โดยไม่ต้องแท็ก @บอท
# หากมีหลายห้องให้คั่นด้วยเครื่องหมายจุลภาค (เช่น 123456789,987654321)
# ถ้าเว้นว่างไว้ บอทจะตอบเฉพาะตอนมีคนแท็ก @บอท, ตอบกลับ (Reply) หรือทักแชท DM
QA_CHANNEL_IDS=
CHAT_CHANNEL_IDS=

# 7. เปิดให้สมาชิกทักแชทส่วนตัว (DM) มาคุยเล่นกับบอทได้ 1-on-1 (true/false)
ALLOW_DM_CHAT=true

# 8. คูลดาวน์ต่อคนในการถามคำถาม (วินาที) ป้องกันการรัวสแปม
COOLDOWN_SECONDS=3

# 9. ตอบแบบส่วนตัวผ่านแชทส่วนตัว DM หรือไม่
PRIVATE_REPLY=false

# 10. จำนวนบทสนทนาย้อนหลังที่บอทจำได้ต่อคน (Default: 10 ข้อความ)
MAX_HISTORY_TURNS=10

# 11. สีกรอบ Embed (Hex code)
BOT_COLOR=0x00d2ff
