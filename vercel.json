{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/Logo.ico" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/discord-auth", "destination": "/api/vip" },
    { "source": "/api/verify-vip", "destination": "/api/vip?action=verify" },
    { "source": "/api/reset-device-test", "destination": "/api/check-session?action=reset" },
    { "source": "/api/shrinkearn-shorten", "destination": "/api/shrinkearn" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|ico|webp|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
