# ==========================================
# 🤖 Discord Bot Configuration
# ==========================================

# Token ของ Discord Bot (ได้จาก Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Client ID / Application ID ของบอท (ได้จาก Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=your_client_id_here

# (ไม่บังคับ) Guild ID เซิร์ฟเวอร์ทดสอบ (หากใส่ Slash Commands จะอัปเดตทันที ไม่ต้องรอคิวของ Discord)
DISCORD_GUILD_ID=

# (ไม่บังคับ) Channel ID ห้องที่ต้องการให้บอทส่งข้อความแจ้งเตือนเมื่อมีสคริปต์ใหม่
DISCORD_NOTIFY_CHANNEL_ID=

# (ไม่บังคับ) Discord Webhook URL สำหรับแจ้งเตือน (ใช้แทน Channel ID หรือใช้คู่กันได้)
DISCORD_WEBHOOK_URL=

# ==========================================
# 🌐 Website Configuration
# ==========================================
# URL ของเว็บไซต์คุณ (สำหรับแนบลิงก์ให้ผู้ใช้คลิกเข้าไปดูสคริปต์)
WEBSITE_URL=http://localhost:3000
