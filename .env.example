# ==========================================
# 🤖 Discord Bot Configuration
# ==========================================

# Token ของ Discord Bot (ได้จาก Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Client ID / Application ID ของบอท (ได้จาก Discord Developer Portal -> General Information)
DISCORD_CLIENT_ID=your_client_id_here

# (ไม่บังคับ) Guild ID เซิร์ฟเวอร์ทดสอบ (หากใส่ Slash Commands จะอัปเดตทันที ไม่ต้องรอคิวของ Discord)
DISCORD_GUILD_ID=

# (ไม่บังคับ) Channel ID ห้องที่ต้องการให้บอทส่งข้อความแจ้งเตือนเมื่อมีสคริปต์ใหม่
DISCORD_NOTIFY_CHANNEL_ID=

# (ไม่บังคับ) Discord Webhook URL สำหรับแจ้งเตือน (ใช้แทน Channel ID หรือใช้คู่กันได้)
DISCORD_WEBHOOK_URL=

# (ไม่บังคับ) Role ID สำหรับจำกัดสิทธิ์การใช้คำสั่ง Slash Command ทั้งหมด
DISCORD_REQUIRED_ROLE_ID=1549727990542508083

# (ไม่บังคับ) Channel ID สำหรับห้องข้ามลิงก์ / รับคีย์อัตโนมัติ (แค่วางลิงก์ลงในห้องนี้)
DISCORD_BYPASS_CHANNEL_ID=1549758071734140958

# (ไม่บังคับ) Channel ID สำหรับกระดานผลสด Blox Fruits (Live Stock 24 ชม.) และแจ้งเตือนผลเข้าใหม่
DISCORD_STOCK_CHANNEL_ID=1549774966474674259
DISCORD_STOCK_ALERT_CHANNEL_ID=1549774966474674259

# (ไม่บังคับ) API Key สำหรับบริการ Bypass พรีเมียม (ถ้ามี)
BYPASS_API_KEY=

# ==========================================
# 🌐 Website Configuration
# ==========================================
# URL ของเว็บไซต์คุณ (สำหรับแนบลิงก์ให้ผู้ใช้คลิกเข้าไปดูสคริปต์)
WEBSITE_URL=http://localhost:3000
